# ── stdio mode (Claude Desktop / local clients) ──────────────────────────
# MCP API key created in QCall → Integrations → AI Assistants (MCP)
QCALL_API_KEY=qc_live_your_key_here
# QCALL_API_BASE_URL=https://api.qcall.ai/api/v1

# ── hosted HTTP mode (mcp.qcall.ai) — put real values in .env (gitignored) ──
# HOST=127.0.0.1
# PORT=8788
# PUBLIC_MCP_URL=https://mcp.qcall.ai/mcp
# MCP_RATE_LIMIT_PER_MIN=120
# MCP_FAILED_AUTH_PER_MIN=30

# OAuth sign-in for Claude.ai / ChatGPT connectors is enabled when this is set (>= 32 random chars).
# MCP_OAUTH_SECRET=
# Optional: "Sign in with Google" on the connector sign-in page (QCall's web client id).
# Leave UNSET until voai-backend verifies the Google ID token audience (signInWithGoogle.controller.js).
# GOOGLE_CLIENT_ID=
# reCAPTCHA v2 site key (QCall's platform key; add the MCP domain to its allowed domains).
# RECAPTCHA_SITE_KEY=
